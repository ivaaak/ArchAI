# Required
ATLAS_URI=                  # MongoDB connection string
REPLICATE_API_TOKEN=        # StableDiffusion / ControlNet via replicate.com

# Optional - generated and uploaded images are stored in Cloudinary when set, otherwise in src/uploads
CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# Optional - Stripe checkout for the pricing page
STRIPE_SECRET_KEY=
STRIPE_PRICE_FREELANCE=     # price_... ids for each plan
STRIPE_PRICE_BUSINESS=
STRIPE_PRICE_ENTERPRISE=

# Optional
PORT=3000
FRONTEND_URL=http://localhost:5173   # CORS origin and default Stripe redirect target
UPLOADS_DIR=                         # defaults to backend/src/uploads
